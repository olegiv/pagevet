# pagevet login configuration.
#
#   cp .env.example .env && chmod 600 .env
#
# Read ONLY when -login is passed, and only from ./.env in the directory you run
# pagevet from. .env is gitignored; this file is not, so never put a real
# password in it.
#
# Every key below is required except LOGOUT_PATH. Values may be quoted or bare;
# a "double-quoted" value understands \n \t \" \\, a 'single-quoted' one is
# literal, and a bare one ends at the first #. Unknown keys are ignored, so
# sharing this file with another tool is fine.

# The login page. Either a path, resolved against the scheme and host of the
# FIRST URL in your input file, or a complete http(s):// URL.
#
# Use the full URL when your list spans more than one host, or when the login
# page lives somewhere other than the site being crawled.
LOGIN_PATH="/login"

# OPTIONAL. A page that signs the browser out, loaded immediately BEFORE the
# login page so the sign-in always starts from a signed-out state.
#
# Leave it out and pagevet goes straight to the login page. Set it when your
# login page behaves differently for an already-authenticated visitor — the
# common case is a login block that is only rendered to anonymous users, which
# would otherwise fail with "no visible form" on a run that had picked up a
# session from a crawled page.
#
# Same two forms as LOGIN_PATH: a path, or a full URL. Note that some sites
# require a one-time token on their logout route (Drupal 10 does), in which case
# a bare /user/logout will not work and this is better left unset.
#LOGOUT_PATH="/logout"

# The id attribute of the <form> element to fill in.
#
# It is also half of the success check: after submitting, this element must be
# gone from the page. Letters, digits and _ : . - only, starting with a letter
# or underscore.
LOGIN_FORM_ID="user-login-form"

# The name attributes of the two inputs inside that form. These are the name=
# attributes, not the id= ones, and not the visible labels.
#
# View source on your login page if you are unsure; Drupal uses name/pass,
# WordPress uses log/pwd.
USERNAME_NAME="name"
PASSWORD_NAME="pass"

# The account pagevet signs in as.
#
# Use the lowest-privilege account that can still see the pages you are
# checking. pagevet renders every URL in your list with this session, and a page
# that deletes something on GET will be just as deleted.
USER_ADMIN_NAME="pagevet"
USER_ADMIN_PASS="change-me"
